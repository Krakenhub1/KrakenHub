-- 4. Cleanup Single & All Player ESP
local function CleanupSinglePlayerESP(p, entry)
    if not entry then return end
    if entry.Billboard then pcall(function() entry.Billboard:Destroy() end) end
    if entry.BoxBB then pcall(function() entry.BoxBB:Destroy() end) end
    if entry.HeadDotBB then pcall(function() entry.HeadDotBB:Destroy() end) end
    if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
    if entry.NativeTag and entry.NativeTag.Parent then
        pcall(function() entry.NativeTag.Enabled = true end)
    end
    Hub.PlayerESPRegistry[p] = nil
end

local function ClearAllPlayerESP()
    for p, entry in pairs(Hub.PlayerESPRegistry) do
        CleanupSinglePlayerESP(p, entry)
    end
    table.clear(Hub.PlayerESPRegistry)
    if Hub.ESPFolder then
        pcall(function() Hub.ESPFolder:ClearAllChildren() end)
    end
    PurgeAllEspContainers()
end

-- 5. Unified Player ESP Update (Tactical Flicker-Free with In-Place Updating)
local function UnifiedPlayerESPUpdate()
    if not Hub.Settings.PlayerESP or not Hub.Running then
        if next(Hub.PlayerESPRegistry) then ClearAllPlayerESP() end
        return
    end

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local currentActive = {}
    local maxDistance = Hub.Settings.ESPMaxDistance or 600
    local maxHighlights = (IsMobile or Hub.Settings.MobileOptimization) and 8 or 20
    local highlightCount = 0
    local chamMaxDist = (IsMobile or Hub.Settings.MobileOptimization) and 140 or 250

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            currentActive[p] = true
            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            local isValid = char and hrp and head and hum and hum.Health > 0 and char.Parent ~= nil
            local entry = Hub.PlayerESPRegistry[p]

            if not isValid then
                if entry then
                    CleanupSinglePlayerESP(p, entry)
                end
                continue
            end

            local dist = (hrp.Position - myHrp.Position).Magnitude
            local inRange = dist <= maxDistance

            if not inRange then
                if entry then
                    if entry.Billboard.Enabled then entry.Billboard.Enabled = false end
                    if entry.BoxBB.Enabled then entry.BoxBB.Enabled = false end
                    if entry.HeadDotBB.Enabled then entry.HeadDotBB.Enabled = false end
                    if entry.Highlight.Enabled then entry.Highlight.Enabled = false end
                    if entry.NativeTag and entry.NativeTag.Parent then
                        entry.NativeTag.Enabled = true
                    end
                end
                continue
            end

            -- 1. ซ่อน OverheadNameBill เดิมของเกมเพื่อแก้ปัญหาชื่อซ้อน 100%
            local nativeTag = head:FindFirstChild("OverheadNameBill")
            if nativeTag and nativeTag.Enabled then
                nativeTag.Enabled = false
            end

            -- 2. สร้าง GUI ใหม่เฉพาะกรณีที่ยังไม่มี หรือตัวละคร respawn ใหม่
            if not entry or entry.Character ~= char or not entry.Billboard or not entry.Billboard.Parent or not entry.BoxBB or not entry.BoxBB.Parent or not entry.HeadDotBB or not entry.HeadDotBB.Parent or not entry.Highlight or not entry.Highlight.Parent then
                if entry then
                    CleanupSinglePlayerESP(p, entry)
                end

                local container = Hub.ESPFolder or targetGuiParent

                -- A. Highlight (Chams ตัวตามสีสถาบัน + ขอบขาวคมชัด)
                local hl = Instance.new("Highlight")
                hl.Name = "KrakenESP_HL_" .. p.Name
                hl.Adornee = char
                hl.FillColor = Color3.fromRGB(235, 35, 35)
                hl.FillTransparency = 0.55
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.OutlineTransparency = 0.1
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = container

                -- B. กรอบตัว Corner Brackets (เหมือนในรูปต้นฉบับ [พระ] peaceful คมชัด ไม่บังเป้า ไร้ปัญหากรงแดง)
                local boxBB = Instance.new("BillboardGui")
                boxBB.Name = "KrakenESP_Box_" .. p.Name
                boxBB.Adornee = hrp
                boxBB.Size = UDim2.new(4.2, 0, 5.6, 0)
                boxBB.StudsOffset = Vector3.new(0, -0.15, 0)
                boxBB.AlwaysOnTop = true
                boxBB.ResetOnSpawn = false
                boxBB.ClipsDescendants = false
                boxBB.MaxDistance = math.min(maxDistance, 200)
                boxBB.Parent = container

                local boxFrame = Instance.new("Frame", boxBB)
                boxFrame.Size = UDim2.fromScale(1, 1)
                boxFrame.BackgroundTransparency = 1
                boxFrame.BorderSizePixel = 0

                local boxLines = {}
                local armX = 0.22
                local armY = 0.18
                local thick = 2

                -- Top-Left (┌)
                local tlH = Instance.new("Frame", boxFrame)
                tlH.Size = UDim2.new(armX, 0, 0, thick)
                tlH.Position = UDim2.new(0, 0, 0, 0)
                tlH.BackgroundColor3 = Color3.fromRGB(240, 40, 40)
                tlH.BorderSizePixel = 0
                table.insert(boxLines, tlH)

                local tlV = Instance.new("Frame", boxFrame)
                tlV.Size = UDim2.new(0, thick, armY, 0)
                tlV.Position = UDim2.new(0, 0, 0, 0)
                tlV.BackgroundColor3 = Color3.fromRGB(240, 40, 40)
                tlV.BorderSizePixel = 0
                table.insert(boxLines, tlV)

                -- Top-Right (┐)
                local trH = Instance.new("Frame", boxFrame)
                trH.Size = UDim2.new(armX, 0, 0, thick)
                trH.Position = UDim2.new(1 - armX, 0, 0, 0)
                trH.BackgroundColor3 = Color3.fromRGB(240, 40, 40)
                trH.BorderSizePixel = 0
