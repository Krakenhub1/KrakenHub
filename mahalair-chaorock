            local function parseNum(key)
                local m = src:match(key .. "%s*=%s*([%d%.]+)")
                return m and tonumber(m)
            end
            local function parseBool(key)
                local m = src:match(key .. "%s*=%s*(%a+)")
                if m == "true" then return true elseif m == "false" then return false end
                return nil
            end
            
            orig.Firerate = parseNum("Firerate")
