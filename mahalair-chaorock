-- High-Performance Movement & Noclip Loop (Cached Parts, Zero Allocations)
local cachedCharParts = {}
local function UpdateCharPartsCache(char)
    table.clear(cachedCharParts)
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            table.insert(cachedCharParts, part)
        end
    end
end

if LocalPlayer.Character then UpdateCharPartsCache(LocalPlayer.Character) end
table.insert(Hub.Connections, LocalPlayer.CharacterAdded:Connect(function(char)
    UpdateCharPartsCache(char)
    table.insert(Hub.Connections, char.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") then
            table.insert(cachedCharParts, part)
        end
    end))
end))

table.insert(Hub.Connections, RunService.Stepped:Connect(function()
    if Hub.Settings.Noclip or (Hub.Settings.AutoFarm and Hub.Settings.AutoNoclip) then
        for i = 1, #cachedCharParts do
            local part = cachedCharParts[i]
            if part and part.Parent and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
    if Hub.Settings.SpeedEnabled then
        local hum = GetHumanoid()
        if hum and hum.WalkSpeed ~= Hub.Settings.WalkSpeed then
            hum.WalkSpeed = Hub.Settings.WalkSpeed
        end
    end
    if Hub.Settings.JumpEnabled then
        local hum = GetHumanoid()
        if hum and hum.JumpPower ~= Hub.Settings.JumpPower then
            hum.JumpPower = Hub.Settings.JumpPower
        end
    end
end))

table.insert(Hub.Connections, UserInputService.JumpRequest:Connect(function()
    if Hub.Settings.InfiniteJump then
        local hum = GetHumanoid()
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))

