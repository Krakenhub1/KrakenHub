        if gf and gf:IsA("LocalScript") and gf.Disabled then
            gf.Disabled = false
        end
    end
end

local function ApplyGunModsToTool(tool)
    if not tool or not tool:IsA("Tool") then return end

    -- 1. CARBON ENGINE GUN HANDLER (มหาลัยชาวร็อค ใช้ระบบนี้เป็นหลัก)
    local cconfigModule = (tool:FindFirstChild("ConfigMods") and tool.ConfigMods:FindFirstChild("CConfig"))
        or tool:FindFirstChild("CConfig")
    if cconfigModule and cconfigModule:IsA("ModuleScript") then
        local ok, ccfg = pcall(require, cconfigModule)
        if ok and typeof(ccfg) == "table" then
            if table.isfrozen(ccfg) and typeof(setreadonly) == "function" then
                pcall(setreadonly, ccfg, false)
            end

            if not OriginalGunSettings[tool] then
                OriginalGunSettings[tool] = GetTrueOriginalCarbon(tool, ccfg, cconfigModule)
            end

            local orig = OriginalGunSettings[tool]

            -- Full-Auto Mod
            if Hub.Settings.GunFullAuto then
                ccfg.AutoEnabled = true
                ccfg.CanSelectFire = true
                ccfg.FireMode = 2 -- 2 = Full-Auto
            else
                ccfg.AutoEnabled = (orig and orig.AutoEnabled ~= nil) and orig.AutoEnabled or false
                ccfg.CanSelectFire = (orig and orig.CanSelectFire ~= nil) and orig.CanSelectFire or false
                ccfg.FireMode = (orig and orig.FireMode) and orig.FireMode or 1
            end

            -- Rapid Fire (จำกัดความเร็วปลอดภัยขั้นต่ำ 0.08s ป้องกัน Server Damage Rate-Limit)
            if Hub.Settings.GunRapidFire then
                ccfg.Firerate = math.max(0.08, Hub.Settings.GunFireRate or 0.08)
                ccfg.CanAutoBolt = true
            else
                ccfg.Firerate = (orig and orig.Firerate and orig.Firerate > 0.08) and orig.Firerate or 0.158
                ccfg.CanAutoBolt = (orig and orig.CanAutoBolt ~= nil) and orig.CanAutoBolt or true
            end

            -- No Recoil & No CamShake
            if Hub.Settings.GunNoRecoil then
                ccfg.gunRecoilMin = 0
                ccfg.gunRecoilMax = 0
                ccfg.AimGunRecoilMin = 0
                ccfg.AimGunRecoilMax = 0
                ccfg.KickbackMin = 0
                ccfg.KickbackMax = 0
                ccfg.AimKickbackMin = 0
                ccfg.AimKickbackMax = 0
                ccfg.SideKickMin = 0
                ccfg.SideKickMax = 0
                ccfg.AimSideKickMin = 0
                ccfg.AimSideKickMax = 0
                ccfg.CamShakeMin = 0
                ccfg.CamShakeMax = 0
                ccfg.AimCanShakeMin = 0
                if ccfg.AimCamShakeMin ~= nil then ccfg.AimCamShakeMin = 0 end
                ccfg.AimCamShakeMax = 0
            else
                ccfg.gunRecoilMin = (orig and orig.gunRecoilMin and orig.gunRecoilMin > 0) and orig.gunRecoilMin or 10
                ccfg.gunRecoilMax = (orig and orig.gunRecoilMax and orig.gunRecoilMax > 0) and orig.gunRecoilMax or 20
                ccfg.AimGunRecoilMin = (orig and orig.AimGunRecoilMin and orig.AimGunRecoilMin > 0) and orig.AimGunRecoilMin or 7
                ccfg.AimGunRecoilMax = (orig and orig.AimGunRecoilMax and orig.AimGunRecoilMax > 0) and orig.AimGunRecoilMax or 14
                ccfg.KickbackMin = (orig and orig.KickbackMin and orig.KickbackMin > 0) and orig.KickbackMin or 2
                ccfg.KickbackMax = (orig and orig.KickbackMax and orig.KickbackMax > 0) and orig.KickbackMax or 4
                ccfg.AimKickbackMin = (orig and orig.AimKickbackMin and orig.AimKickbackMin > 0) and orig.AimKickbackMin or 1
                ccfg.AimKickbackMax = (orig and orig.AimKickbackMax and orig.AimKickbackMax > 0) and orig.AimKickbackMax or 3
                ccfg.SideKickMin = (orig and orig.SideKickMin and orig.SideKickMin > 0) and orig.SideKickMin or 1
                ccfg.SideKickMax = (orig and orig.SideKickMax and orig.SideKickMax > 0) and orig.SideKickMax or 2
                ccfg.AimSideKickMin = (orig and orig.AimSideKickMin and orig.AimSideKickMin > 0) and orig.AimSideKickMin or 1
                ccfg.AimSideKickMax = (orig and orig.AimSideKickMax and orig.AimSideKickMax > 0) and orig.AimSideKickMax or 2
                ccfg.CamShakeMin = (orig and orig.CamShakeMin and orig.CamShakeMin > 0) and orig.CamShakeMin or 2
                ccfg.CamShakeMax = (orig and orig.CamShakeMax and orig.CamShakeMax > 0) and orig.CamShakeMax or 5
                ccfg.AimCanShakeMin = 1
                if ccfg.AimCamShakeMin ~= nil then ccfg.AimCamShakeMin = 1 end
                ccfg.AimCamShakeMax = 3
            end

            -- No Spread
            if Hub.Settings.GunNoSpread then
                ccfg.BulletSpread = 0
                ccfg.BulletPhysics = Vector3.zero
            else
                ccfg.BulletSpread = (orig and orig.BulletSpread) and orig.BulletSpread or 0
                ccfg.BulletPhysics = Vector3.new(0, 0, 0)
            end

            -- High Velocity
            if Hub.Settings.GunHighVelocity then
                ccfg.BulletSpeed = Hub.Settings.GunBulletSpeed or 8000
                ccfg.BulletPhysics = Vector3.zero
            else
                ccfg.BulletSpeed = (orig and orig.BulletSpeed and orig.BulletSpeed < 8000) and orig.BulletSpeed or 2000
                ccfg.BulletPhysics = Vector3.new(0, 0, 0)
            end

            return
        end
    end

    -- 2. FE GUN KIT FALLBACK (สำหรับปืนระบบ Setting ทั่วไป)
    local settingModule = tool:FindFirstChild("Setting")
    if settingModule and settingModule:IsA("ModuleScript") then
        local ok, setting = pcall(require, settingModule)
        if ok and typeof(setting) == "table" then
            if not OriginalGunSettings[tool] then
                OriginalGunSettings[tool] = {
                    Engine = "FEGunKit",
                    Auto = (setting.Auto ~= nil) and setting.Auto or false,
                    FireRate = (setting.FireRate and setting.FireRate > 0.05) and setting.FireRate or 0.15,
                    Recoil = (setting.Recoil and setting.Recoil > 0) and setting.Recoil or 5,
                    CameraRecoilingEnabled = true,
                    ScopeKnockbackSpeed = 10,
                    RecoilSpeed = 10,
                    AngleX_Min = 1,
                    AngleX_Max = 2,
                    AngleY_Min = 1,
                    AngleY_Max = 2,
                    AngleZ_Min = 0,
                    AngleZ_Max = 0,
                    Spread = (setting.Spread and setting.Spread > 0) and setting.Spread or 1,
                    Accuracy = 0.9,
                    BulletSpeed = (setting.BulletSpeed and setting.BulletSpeed < 8000) and setting.BulletSpeed or 2000,
                    BulletAcceleration = Vector3.new(0, -9.8, 0),
                    EquipTime = 0.5,
                }
            end

            local orig = OriginalGunSettings[tool]

            -- Full-Auto Mod
            if Hub.Settings.GunFullAuto then
                setting.Auto = true
            else
                setting.Auto = (orig and orig.Auto ~= nil) and orig.Auto or false
            end

            -- Rapid Fire
            if Hub.Settings.GunRapidFire then
                setting.FireRate = Hub.Settings.GunFireRate or 0.05
            else
                setting.FireRate = (orig and orig.FireRate and orig.FireRate > 0.05) and orig.FireRate or 0.15
            end

            -- No Recoil
            if Hub.Settings.GunNoRecoil then
                setting.Recoil = 0
                setting.CameraRecoilingEnabled = false
                setting.ScopeKnockbackSpeed = 0
                setting.RecoilSpeed = 0
                setting.AngleX_Min = 0
                setting.AngleX_Max = 0
                setting.AngleY_Min = 0
                setting.AngleY_Max = 0
                setting.AngleZ_Min = 0
                setting.AngleZ_Max = 0
            else
                setting.Recoil = (orig and orig.Recoil) and orig.Recoil or 5
                setting.CameraRecoilingEnabled = true
                setting.ScopeKnockbackSpeed = 10
                setting.RecoilSpeed = 10
                setting.AngleX_Min = 1
                setting.AngleX_Max = 2
                setting.AngleY_Min = 1
                setting.AngleY_Max = 2
                setting.AngleZ_Min = 0
                setting.AngleZ_Max = 0
            end

            -- No Spread
            if Hub.Settings.GunNoSpread then
                setting.Spread = 0
                setting.Accuracy = 1
                setting.SpreadRedutionIS = 0
                setting.SpreadRedutionS = 0
            else
                setting.Spread = (orig and orig.Spread) and orig.Spread or 1
                setting.Accuracy = (orig and orig.Accuracy) and orig.Accuracy or 0.9
            end

            -- High Velocity
            if Hub.Settings.GunHighVelocity then
                setting.BulletSpeed = Hub.Settings.GunBulletSpeed or 8000
                setting.BulletAcceleration = Vector3.zero
            else
                setting.BulletSpeed = (orig and orig.BulletSpeed and orig.BulletSpeed < 8000) and orig.BulletSpeed or 2000
                setting.BulletAcceleration = Vector3.new(0, -9.8, 0)
            end

            -- Instant Equip
            if Hub.Settings.GunInstantEquip then
                setting.EquipTime = 0
            else
                setting.EquipTime = (orig and orig.EquipTime) and orig.EquipTime or 0.5
            end
        end
    end
end

local function ScanAndApplyAllGuns()
    pcall(ApplyGlobalCarbonConfig)
    pcall(SuppressGunFeel)

    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") then pcall(ApplyGunModsToTool, child) end
        end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if child:IsA("Tool") then pcall(ApplyGunModsToTool, child) end
        end
    end
end

-- RenderStep Neutralizer for Camera Shake (Zero Overhead Bind)
local recoilBound = false
local function UpdateNoRecoilState()
    if Hub.Settings and Hub.Settings.GunNoRecoil then
        if not recoilBound then
            recoilBound = true
            pcall(function()
                RunService:BindToRenderStep("GunFeelShake", Enum.RenderPriority.Camera.Value + 1, function() end)
            end)
        end
    else
        if recoilBound then
            recoilBound = false
            pcall(function()
                RunService:UnbindFromRenderStep("GunFeelShake")
            end)
        end
    end
end

