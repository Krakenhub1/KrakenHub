local function Cleanup()
    Hub.Running = false
    Hub.Settings.FarmCurrentSpot = false
    Hub.Settings.AutoFarm = false
    Hub.Settings.HardcoreRotate = false
    
    for _, conn in ipairs(Hub.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Hub.Connections)
    
    for _, obj in pairs(Hub.ESPObjects) do
        pcall(function()
            if typeof(obj) == "Instance" then
                obj:Destroy()
            elseif typeof(obj) == "table" and obj.Remove then
                obj:Remove()
            end
        end)
    end
    table.clear(Hub.ESPObjects)

    if Hub.PlayerESPRegistry then
        for p, entry in pairs(Hub.PlayerESPRegistry) do
            if entry.Billboard then pcall(function() entry.Billboard:Destroy() end) end
            if entry.BoxBB then pcall(function() entry.BoxBB:Destroy() end) end
            if entry.HeadDotBB then pcall(function() entry.HeadDotBB:Destroy() end) end
            if entry.Highlight then pcall(function() entry.Highlight:Destroy() end) end
            if entry.NativeTag and entry.NativeTag.Parent then
                pcall(function() entry.NativeTag.Enabled = true end)
            end
        end
        table.clear(Hub.PlayerESPRegistry)
    end
    pcall(function()
        if Hub.ESPFolder then
            Hub.ESPFolder:Destroy()
            Hub.ESPFolder = nil
        end
        local oldFolder = targetGuiParent:FindFirstChild("KrakenHub_ESP_Folder")
        if oldFolder then oldFolder:Destroy() end
        local rFolder = game:GetService("CoreGui"):FindFirstChild("RobloxGui") and game:GetService("CoreGui").RobloxGui:FindFirstChild("KrakenHub_ESP_Folder")
        if rFolder then rFolder:Destroy() end

        for _, c in ipairs(targetGuiParent:GetChildren()) do
            if c:IsA("BillboardGui") and (c.Name:find("KrakenESP_") or c.Name:find("StationESP_")) then
                c:Destroy()
            end
            if c:IsA("Highlight") and c.Name:find("KrakenESP_") then
                c:Destroy()
            end
        end
    end)
    
    if Hub.SilentAimFOVCircle then
        pcall(function() Hub.SilentAimFOVCircle:Remove() end)
        Hub.SilentAimFOVCircle = nil
    end
    if Hub.TargetTracerLine then
        pcall(function() Hub.TargetTracerLine:Remove() end)
        Hub.TargetTracerLine = nil
    end
    if Hub.FOVGui then
        pcall(function() Hub.FOVGui:Destroy() end)
        Hub.FOVGui = nil
    end
    pcall(function()
        local g1 = targetGuiParent and targetGuiParent:FindFirstChild("KrakenHub_FOV_Gui")
        if g1 then g1:Destroy() end
        local g2 = game:GetService("CoreGui"):FindFirstChild("KrakenHub_FOV_Gui")
        if g2 then g2:Destroy() end
        local lp = game:GetService("Players").LocalPlayer
        local g3 = lp and lp:FindFirstChildOfClass("PlayerGui") and lp.PlayerGui:FindFirstChild("KrakenHub_FOV_Gui")
        if g3 then g3:Destroy() end
    end)
    
    local cfUi = LocalPlayer:FindFirstChildOfClass("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("ConstructionFarmUI")
    if cfUi then cfUi.Enabled = true end
    
    if Hub.Window and Hub.Window.Unload then
        pcall(function() Hub.Window:Unload() end)
    end
    if Hub.ToggleButtonGui then
        pcall(function() Hub.ToggleButtonGui:Destroy() end)
    end
    
    if Hub.ESPFolder then
        pcall(function() Hub.ESPFolder:Destroy() end)
        Hub.ESPFolder = nil
    end
    if Hub.HLFolder then
        pcall(function() Hub.HLFolder:Destroy() end)
