local function GetOrCreateStationESP(sName, info)
    local bg = Hub.ESPObjects["Station_" .. sName]
    if bg and bg.Parent ~= nil then return bg end
    
    local cf = Workspace:FindFirstChild("ConstructionFarm")
    local stations = cf and cf:FindFirstChild("Stations")
    local station = stations and stations:FindFirstChild(sName)
    local pp = station and station:FindFirstChild("PromptPart")
    if not pp then return nil end
    
    bg = Instance.new("BillboardGui")
    bg.Name = "StationESP_" .. sName
    bg.Adornee = pp
    bg.Size = UDim2.fromOffset(155, 46)
    bg.StudsOffset = Vector3.new(0, 3.2, 0)
    bg.AlwaysOnTop = true
    bg.ResetOnSpawn = false
    bg.MaxDistance = 1500
    pcall(function() bg.Parent = ESPFolder end)

    local isPathum = (info.team == "Pathumwan")
    local teamCol = isPathum and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(0, 150, 255)
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.fromScale(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 0
    frame.Parent = bg
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = teamCol
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent = frame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, -6, 0, 18)
    titleLabel.Position = UDim2.new(0, 3, 0, 3)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 11
