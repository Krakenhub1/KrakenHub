local function DoInstantDeliveryOnce()
    local jobsFolder = ReplicatedStorage:FindFirstChild("Jobs")
    local req = jobsFolder and jobsFolder:FindFirstChild("Request")
    if not req then return false end
    
    local success = false
    pcall(function()
        req:InvokeServer("StartJob")
        task.wait(0.2)
        local jobLocs = Workspace:FindFirstChild("Jobs") or Workspace:FindFirstChild("JobLocations")
        if jobLocs then
            for _, loc in ipairs(jobLocs:GetChildren()) do
                if loc:IsA("BasePart") or loc:IsA("Model") then
                    local pos = loc:IsA("BasePart") and loc.Position or loc:GetPivot().Position
                    SafeTeleport(pos)
                    task.wait(0.12)
                end
            end
            success = true
        end
    end)
    return success
end

