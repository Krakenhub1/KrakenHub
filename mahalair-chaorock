local function GetStationPrompt(stationName)
    local cf = Workspace:FindFirstChild("ConstructionFarm")
    local stations = cf and cf:FindFirstChild("Stations")
    local station = stations and stations:FindFirstChild(stationName)
    local pp = station and station:FindFirstChild("PromptPart")
    return pp and pp:FindFirstChildOfClass("ProximityPrompt")
end

local function IsStationFree(prompt)
    if not prompt or not prompt.Enabled then return false end
    local busy = prompt:GetAttribute("BusyBy")
    return busy == nil or busy == 0 or busy == LocalPlayer.UserId
end

-- Find closest station to current character position
local function GetClosestStation()
    local root = GetRoot()
    if not root then return nil end
    local closest = nil
    local closestDist = 9999
    
    for sName, info in pairs(STATIONS) do
        local dist = (root.Position - info.pos).Magnitude
        if dist < closestDist then
            closestDist = dist
            local prompt = GetStationPrompt(sName)
            closest = {
                name = sName,
                info = info,
                prompt = prompt,
                dist = dist
            }
        end
    end
    return closest
end

local function GetAvailableStations(jobFilter)
    local myTeam = GetPlayerTeam()
    local available = {}
    
    for sName, info in pairs(STATIONS) do
        local teamAllowed = (myTeam == "Civilian") or (info.team == myTeam) or (myTeam == "Neutral")
        local jobMatched = (jobFilter == "Auto") or (info.job == jobFilter)
        
        if teamAllowed and jobMatched then
            local prompt = GetStationPrompt(sName)
            if prompt and prompt.Enabled and IsStationFree(prompt) then
                table.insert(available, {
                    name = sName,
                    info = info,
                    prompt = prompt
                })
            end
        end
    end
    
    table.sort(available, function(a, b)
        local rateA = a.info.pay / a.info.minTime
        local rateB = b.info.pay / b.info.minTime
        return rateA > rateB
    end)
    
    return available
end

-- Teleport character smoothly
local function SafeTeleport(targetPos)
    local char = GetCharacter()
    if not char then return false end
    
    local standPos = targetPos + Vector3.new(0, 1.5, 0)
    local root = GetRoot(char)
    local currentRot = (root and root.CFrame.Rotation) or CFrame.identity
    
    char:PivotTo(CFrame.new(standPos) * currentRot)
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    task.wait(0.04)
    return true
end

