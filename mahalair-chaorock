    end
    
    for _, name in ipairs({"KrakenHub_ToggleButton", "KrakenHub_UI", "Maclib", "Fluent", "KrakenChassis_UI", "KrakenHub_ESP_Folder"}) do
        local old = targetGuiParent:FindFirstChild(name)
        if old then pcall(function() old:Destroy() end) end
    end
