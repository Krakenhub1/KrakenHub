local function IsTargetVisible(targetPart)
    if not Camera or not targetPart then return false end
    local origin = Camera.CFrame.Position
    local targetPos = targetPart.Position
    local rayDir = targetPos - origin
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local filterList = { LocalPlayer.Character }
    local cam = Workspace.CurrentCamera
    if cam then table.insert(filterList, cam) end
    rayParams.FilterDescendantsInstances = filterList
    
    local result = Workspace:Raycast(origin, rayDir, rayParams)
    if result and result.Instance then
        if result.Instance:IsDescendantOf(targetPart.Parent) then
            return true
        end
        if result.Instance.Transparency > 0.8 or not result.Instance.CanCollide then
            return true
        end
        return false
    end
    return true
end

local function GetTargetBone(char)
    if not char then return nil end
    local boneName = Hub.Settings.SilentAimTargetPart or "Head"
    if boneName == "Head" then
        return char:FindFirstChild("Head")
    elseif boneName == "Torso" then
        return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
    elseif boneName == "HumanoidRootPart" then
        return char:FindFirstChild("HumanoidRootPart")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function GetBestFOVTarget()
    if not Camera then return nil end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myTeam = LocalPlayer.Team
    
    local aimOrigin = GetAimOrigin()
    local fovLimit = Hub.Settings.SilentAimFOV or 150
    local closestTarget = nil
    local closestDist = fovLimit
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local isFriendly = false
            if Hub.Settings.TeamCheck and myTeam and player.Team then
                if player.Team == myTeam and myTeam.Name ~= "Neutral" and myTeam.Name ~= "Civilian" then
                    isFriendly = true
                end
            end
            
            if not isFriendly then
                local char = player.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                if char and hum and hum.Health > 0 and root then
                    local isKO = char:GetAttribute("Downed") or char:GetAttribute("KO")
                    if not isKO then
                        local part = GetTargetBone(char)
                        if part then
                            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen and screenPos.Z > 0 then
                                local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - aimOrigin).Magnitude
                                if dist2D <= closestDist then
                                    local visible = true
                                    if Hub.Settings.WallCheck then
                                        visible = IsTargetVisible(part)
                                    end
                                    
                                    if visible then
                                        closestDist = dist2D
                                        closestTarget = {
                                            Player = player,
                                            Character = char,
                                            Humanoid = hum,
                                            Part = part,
                                            Position = part.Position,
                                            Dist2D = dist2D,
                                            ScreenPos = Vector2.new(screenPos.X, screenPos.Y)
                                        }
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closestTarget
end

-- 🚀 Dynamic Bullet Guidance Engine (Physical Homing / Bullet Redirection)
local function AttachBulletHoming(bullet)
    if not (Hub.Running and Hub.Settings.SilentAim and LockedTarget and LockedTarget.Part) then return end
    
    local hitChance = Hub.Settings.HitChance or 100
    if (hitChance < 100) and (math.random(1, 100) > hitChance) then return end
    
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    
    -- Verify bullet spawned in proximity to player
    local distFromUs = (bullet.Position - myRoot.Position).Magnitude
    if distFromUs > 25 then return end
    
    local targetPart = LockedTarget.Part
    if not (targetPart and targetPart.Parent) then return end
    
    task.spawn(function()
        local speed = bullet.Velocity.Magnitude
        if speed < 10 then speed = 800 end
        
        local bodyForce = bullet:FindFirstChildOfClass("BodyForce")
        if bodyForce then
            bodyForce.Force = Vector3.zero
        end
        
        local homingConn
        homingConn = RunService.Heartbeat:Connect(function()
            if not (bullet and bullet.Parent and targetPart and targetPart.Parent) then
                if homingConn then homingConn:Disconnect() end
                return
            end
            
            local dir = (targetPart.Position - bullet.Position).Unit
            bullet.CFrame = CFrame.new(bullet.Position, targetPart.Position)
            bullet.Velocity = dir * speed
            
            if (bullet.Position - targetPart.Position).Magnitude < 4.5 then
                bullet.CFrame = targetPart.CFrame
                if homingConn then homingConn:Disconnect() end
            end
        end)
        
        task.delay(4, function()
            if homingConn then homingConn:Disconnect() end
        end)
    end)
end

