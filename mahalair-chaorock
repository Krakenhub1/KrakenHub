                brV.BackgroundColor3 = Color3.fromRGB(240, 40, 40)
                brV.BorderSizePixel = 0
                table.insert(boxLines, brV)

                -- C. จุดเล็งศีรษะ (Head Dot)
                local dotBB = Instance.new("BillboardGui")
                dotBB.Name = "KrakenESP_Dot_" .. p.Name
                dotBB.Adornee = head
                dotBB.Size = UDim2.fromOffset(6, 6)
                dotBB.StudsOffset = Vector3.new(0, 0.1, 0)
                dotBB.AlwaysOnTop = true
                dotBB.ResetOnSpawn = false
                dotBB.MaxDistance = math.min(maxDistance, 200)
                dotBB.Parent = container

                local dotFrame = Instance.new("Frame", dotBB)
                dotFrame.Size = UDim2.fromScale(1, 1)
                dotFrame.BackgroundColor3 = Color3.fromRGB(240, 40, 40)
                dotFrame.BorderSizePixel = 0
                Instance.new("UICorner", dotFrame).CornerRadius = UDim.new(1, 0)

                local dotStroke = Instance.new("UIStroke", dotFrame)
                dotStroke.Color = Color3.fromRGB(15, 15, 20)
                dotStroke.Thickness = 1

                -- D. ป้ายข้อมูลเหนือศีรษะ แบบ Clean Minimalist (ไร้ขอบดำ/กรอบการ์ด ลอยกลางอากาศคมชัดแบบ Image 1)
                local bb = Instance.new("BillboardGui")
                bb.Name = "KrakenESP_BB_" .. p.Name
                bb.Adornee = head
                bb.Size = UDim2.fromOffset(130, 26)
                bb.StudsOffset = Vector3.new(0, 2.2, 0)
                bb.AlwaysOnTop = true
                bb.ResetOnSpawn = false
                bb.ClipsDescendants = false
                bb.MaxDistance = maxDistance
                bb.Parent = container

                local bbCard = Instance.new("Frame", bb)
                bbCard.Size = UDim2.fromScale(1, 1)
                bbCard.BackgroundTransparency = 1
                bbCard.BorderSizePixel = 0

                local cardStroke = Instance.new("UIStroke", bbCard)
                cardStroke.Enabled = false

                local nameLbl = Instance.new("TextLabel", bbCard)
                nameLbl.Size = UDim2.new(1, -42, 0, 13)
                nameLbl.Position = UDim2.new(0, 0, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                nameLbl.Font = Enum.Font.GothamBold
                nameLbl.TextSize = 10
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.TextStrokeTransparency = 0
                nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

                local hpValLbl = Instance.new("TextLabel", bbCard)
                hpValLbl.Size = UDim2.new(0, 36, 0, 13)
                hpValLbl.Position = UDim2.new(1, -36, 0, 0)
                hpValLbl.BackgroundTransparency = 1
                hpValLbl.TextColor3 = Color3.fromRGB(46, 204, 113)
                hpValLbl.Font = Enum.Font.GothamBold
                hpValLbl.TextSize = 10
                hpValLbl.TextXAlignment = Enum.TextXAlignment.Right
                hpValLbl.TextStrokeTransparency = 0
                hpValLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

                local hpBarBg = Instance.new("Frame", bbCard)
                hpBarBg.Size = UDim2.new(0, 36, 0, 3)
                hpBarBg.Position = UDim2.new(1, -36, 0, 15)
                hpBarBg.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
                hpBarBg.BackgroundTransparency = 0.2
                hpBarBg.BorderSizePixel = 0
                Instance.new("UICorner", hpBarBg).CornerRadius = UDim.new(0, 1)

                local hpBarFill = Instance.new("Frame", hpBarBg)
                hpBarFill.Size = UDim2.fromScale(1, 1)
                hpBarFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
                hpBarFill.BorderSizePixel = 0
                Instance.new("UICorner", hpBarFill).CornerRadius = UDim.new(0, 1)

                local infoLbl = Instance.new("TextLabel", bbCard)
                infoLbl.Size = UDim2.new(1, -40, 0, 11)
                infoLbl.Position = UDim2.new(0, 0, 0, 13)
                infoLbl.BackgroundTransparency = 1
                infoLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
                infoLbl.Font = Enum.Font.GothamMedium
                infoLbl.TextSize = 9
                infoLbl.TextXAlignment = Enum.TextXAlignment.Left
                infoLbl.TextStrokeTransparency = 0
                infoLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                infoLbl.TextTruncate = Enum.TextTruncate.AtEnd

                entry = {
                    Highlight = hl,
                    BoxBB = boxBB,
                    BoxLines = boxLines,
                    HeadDotBB = dotBB,
                    HeadDotFrame = dotFrame,
                    Billboard = bb,
                    CardStroke = cardStroke,
                    NameLabel = nameLbl,
                    HpValueLabel = hpValLbl,
                    HpBarBg = hpBarBg,
                    HpBarFill = hpBarFill,
                    InfoLabel = infoLbl,
                    Player = p,
                    Character = char,
                    NativeTag = nativeTag
                }
                Hub.PlayerESPRegistry[p] = entry
            else
                entry.NativeTag = nativeTag
            end

            -- 3. ตรวจจับข้อมูลสถาบันและสีประจำสถาบันตามที่แมพแบ่งไว้
            local rawTeamName = p.Team and tostring(p.Team.Name) or ""
            local teamColorObj = p.Team and p.Team.TeamColor and p.Team.TeamColor.Color or nil

            local schoolCol = teamColorObj or Color3.fromRGB(245, 245, 245)
            local schoolShort = rawTeamName ~= "" and rawTeamName or "ประชาชน"

            local matchedConfig = false
            for _, sc in ipairs(SchoolConfigs) do
                if string.find(string.lower(rawTeamName), string.lower(sc.Key), 1, true) then
                    schoolCol = sc.Color
                    schoolShort = sc.Short
                    matchedConfig = true
                    break
                end
            end

            if not matchedConfig and rawTeamName == "" then
                if entry.CachedSchool then
                    rawTeamName = entry.CachedSchool
                    schoolCol = entry.CachedColor or schoolCol
                    schoolShort = entry.CachedShort or schoolShort
                else
                    local ovTag = head:FindFirstChild("OverheadNameBill") or head:FindFirstChildWhichIsA("BillboardGui")
                    if ovTag then
                        for _, d in ipairs(ovTag:GetChildren()) do
                            if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
                                for _, sc in ipairs(SchoolConfigs) do
                                    if string.find(string.lower(d.Text), string.lower(sc.Key), 1, true) then
                                        rawTeamName = sc.Key
                                        schoolCol = sc.Color
                                        schoolShort = sc.Short
                                        matchedConfig = true
                                        break
                                    end
                                end
                            end
                            if matchedConfig then break end
                        end
                    end
                    if not matchedConfig then
                        for _, d in ipairs(char:GetChildren()) do
                            if d:IsA("BillboardGui") then
                                for _, lbl in ipairs(d:GetChildren()) do
                                    if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" then
                                        for _, sc in ipairs(SchoolConfigs) do
                                            if string.find(string.lower(lbl.Text), string.lower(sc.Key), 1, true) then
                                                rawTeamName = sc.Key
                                                schoolCol = sc.Color
                                                schoolShort = sc.Short
                                                matchedConfig = true
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                            if matchedConfig then break end
                        end
                    end
                    entry.CachedSchool = rawTeamName ~= "" and rawTeamName or "ประชาชน"
                    entry.CachedColor = schoolCol
                    entry.CachedShort = schoolShort
                end
            end

            -- 4. ตรวจจับอาวุธ
            local wepText = "มือเปล่า"
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool.Name then
                local tName = tool.Name
                local lower = string.lower(tName)
                if lower ~= "fists" and lower ~= "fist" and tName ~= "หมัด" and tName ~= "มือเปล่า" then
                    wepText = tName
                end
            end

            -- 5. คำนวณหลอดเลือด
            local curHp = math.max(0, hum.Health)
            local maxHp = math.max(1, hum.MaxHealth)
            local hpRatio = math.clamp(curHp / maxHp, 0, 1)
            local hpCol = hpRatio > 0.7 and Color3.fromRGB(46, 204, 113) or (hpRatio > 0.35 and Color3.fromRGB(243, 156, 18) or Color3.fromRGB(231, 76, 60))

            -- 6. อัปเดตข้อมูลบน GUI แบบ In-Place
            local forceRed = Hub.Settings.ESPTacticalStyle == true
            local themeColor = forceRed and Color3.fromRGB(240, 40, 40) or schoolCol

            -- อัปเดต Highlight (Chams ตัวตามสีสถาบัน: แสดงเฉพาะระยะปลอดภัย และจำกัดจำนวนไม่ให้แลค/ค้างบน Delta iOS และมือถือ)
            if Hub.Settings.ESPShowChams ~= false and dist <= chamMaxDist and highlightCount < maxHighlights then
                highlightCount = highlightCount + 1
                if not entry.Highlight.Enabled then entry.Highlight.Enabled = true end
                if entry.Highlight.Adornee ~= char then entry.Highlight.Adornee = char end
                if entry.LastFillColor ~= themeColor then
                    entry.LastFillColor = themeColor
                    entry.Highlight.FillColor = themeColor
                end
            else
                if entry.Highlight.Enabled then entry.Highlight.Enabled = false end
            end

            -- อัปเดต Corner Box (จำกัดระยะ <= 200 ม. ป้องกันกล่องจิ๋ว/กรงแดงบัคลอยบนทรายหรือตึกไกล 100%)
            if Hub.Settings.ESPShowBox ~= false and dist <= 200 then
                if not entry.BoxBB.Enabled then entry.BoxBB.Enabled = true end
                local clampedBoxDist = math.min(maxDistance, 200)
                if entry.BoxBB.MaxDistance ~= clampedBoxDist then entry.BoxBB.MaxDistance = clampedBoxDist end
                if entry.LastBoxColor ~= themeColor then
                    entry.LastBoxColor = themeColor
                    for _, line in ipairs(entry.BoxLines or {}) do
                        line.BackgroundColor3 = themeColor
                    end
                end
            else
                if entry.BoxBB.Enabled then entry.BoxBB.Enabled = false end
            end

            -- อัปเดต Head Dot (จำกัดระยะ <= 180 ม.)
            if Hub.Settings.ESPShowHeadDot ~= false and dist <= 180 then
                if not entry.HeadDotBB.Enabled then entry.HeadDotBB.Enabled = true end
                local clampedDotDist = math.min(maxDistance, 180)
                if entry.HeadDotBB.MaxDistance ~= clampedDotDist then entry.HeadDotBB.MaxDistance = clampedDotDist end
                if entry.LastDotColor ~= themeColor then
                    entry.LastDotColor = themeColor
                    entry.HeadDotFrame.BackgroundColor3 = themeColor
                end
            else
                if entry.HeadDotBB.Enabled then entry.HeadDotBB.Enabled = false end
            end

            -- อัปเดต Billboard ป้ายชื่อและสเตตัส
            if not entry.Billboard.Enabled then entry.Billboard.Enabled = true end
            if entry.Billboard.MaxDistance ~= maxDistance then entry.Billboard.MaxDistance = maxDistance end

            if entry.LastNameColor ~= themeColor then
                entry.LastNameColor = themeColor
                entry.NameLabel.TextColor3 = themeColor
                if entry.CardStroke then entry.CardStroke.Color = themeColor end
            end
            local newNameText = (schoolShort ~= "" and schoolShort ~= "ประชาชน") and string.format("[%s] %s", schoolShort, p.DisplayName) or p.DisplayName
            if entry.LastNameText ~= newNameText then
                entry.LastNameText = newNameText
                entry.NameLabel.Text = newNameText
            end

            -- ตัวเลขเลือด + หลอดเลือดแนวนอน
            if Hub.Settings.ESPShowHealthBar ~= false then
                if not entry.HpBarBg.Visible then
                    entry.HpValueLabel.Visible = true
                    entry.HpBarBg.Visible = true
                end
                local hpInt = math.floor(curHp)
                if entry.LastHpInt ~= hpInt then
                    entry.LastHpInt = hpInt
                    entry.HpValueLabel.Text = tostring(hpInt)
                    entry.HpValueLabel.TextColor3 = hpCol
                    entry.HpBarFill.Size = UDim2.new(hpRatio, 0, 1, 0)
                    entry.HpBarFill.BackgroundColor3 = hpCol
                end
            else
                if entry.HpBarBg.Visible then
                    entry.HpValueLabel.Visible = false
                    entry.HpBarBg.Visible = false
                end
            end

            -- ข้อมูลระยะทาง & อาวุธ
            local distInt = math.floor(dist * 0.28)
            local wepClean = nil
            if Hub.Settings.ESPShowWeapon then
                local thaiWep = GetEquippedToolNameThai(char)
                if thaiWep and thaiWep ~= "" and thaiWep ~= "มือเปล่า" then
                    wepClean = thaiWep
                elseif wepText ~= "" and wepText ~= "มือเปล่า" then
                    wepClean = wepText
                end
            end

            if Hub.Settings.ESPShowDistance or wepClean then
                local newInfo = ""
                if Hub.Settings.ESPShowDistance and wepClean then
                    newInfo = string.format("%dm • %s", distInt, wepClean)
                elseif Hub.Settings.ESPShowDistance then
                    newInfo = string.format("%dm", distInt)
                else
                    newInfo = wepClean
                end
                if entry.LastInfoText ~= newInfo then
                    entry.LastInfoText = newInfo
                    entry.InfoLabel.Text = newInfo
                    entry.InfoLabel.Visible = true
                end
            else
                if entry.InfoLabel.Visible then
                    entry.InfoLabel.Visible = false
                    entry.LastInfoText = nil
                end
            end
        end
    end

    -- ล้างข้อมูลผู้เล่นที่ออกจากเซิร์ฟเวอร์
    for p, entry in pairs(Hub.PlayerESPRegistry) do
        if not currentActive[p] or not p.Parent then
            CleanupSinglePlayerESP(p, entry)
        end
    end

    -- กวาดล้าง Orphan Instances ใน ESPFolder โดยตรง (กำจัดขยะตกค้างและกล่องลอยบนทราย/ตึก 100%)
    local container = Hub.ESPFolder or targetGuiParent
    if container then
        for _, child in ipairs(container:GetChildren()) do
            local cName = child.Name
            if child:IsA("BillboardGui") or child:IsA("Highlight") then
                local pName = cName:match("^KrakenESP_HL_(.+)$")
                    or cName:match("^KrakenESP_Box_(.+)$")
                    or cName:match("^KrakenESP_Dot_(.+)$")
                    or cName:match("^KrakenESP_BB_(.+)$")
                if pName then
                    local targetPlr = Players:FindFirstChild(pName)
                    local tChar = targetPlr and targetPlr.Character
                    local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    local isAlive = targetPlr and tChar and tHrp and tHum and tHum.Health > 0 and tChar.Parent ~= nil
                    if not isAlive then
                        pcall(function() child:Destroy() end)
                    end
                end
            end
        end
    end
end

